@model IEnumerable<Guestbook.Models.Message>

<div class="show-comments">
    @if (Context.Session.GetString("login") != null)
    {
        <form asp-action="Index" class="feedback-form">
            <div class="textarea-wrapper">
                <label>Ваш коментар</label>
                <textarea name="comment" placeholder="Введіть текст...">
                </textarea>
            </div>
            <input type="submit" class="submit-btn">
        </form>
    }
    @foreach(var message in Model)
    {
        <div class="comment">
             <p class="login">@message.User!.Login</p>
             <p class="date">@message.Date</p>         
             <p>@message.Text<p/>
        </div>
    }
</div>
