@model Guestbook.Models.LoginModel

<div class="auth-card">
    <h2>Вхід</h2>
    <form asp-action="Index">
        <div asp-validation-summary="ModelOnly" class="error-summary"></div>
        <div class="input-group">
            <label asp-for="Login"></label><br />
            <input asp-for="Login" placeholder="Логін" /><br />
            <span asp-validation-for="Login" class="error"></span>
        </div>
        <div class="input-group">
            <label asp-for="Password"></label><br />
            <input asp-for="Password" placeholder="Пароль"/><br />
            <span asp-validation-for="Password" class="error"></span>
        </div>
        <div class="button-group">
            <input type="submit" value="Увійти"/>
            <a asp-controller="Comments" asp-action="Index" class="error">Повернутися</a>
        </div>
        @section Scripts {
            @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
        }
    </form>
</div>
