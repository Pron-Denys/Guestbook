<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Guestbook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Guestbook.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/GuestbookStyle.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Comments" asp-action="Index">Guestbook</a>
            </div>
            @if (Context.Session.GetString("login") == null)
            {
                <div class="account">
                    <a asp-controller="Account" asp-action="Index" class="sign-in">Вхід</a>
                    <a asp-controller="Account" asp-action="Registration" class="registration" title="Зареєструватися">Зареєструватися</a>
                </div>
            }
            else
            {
                <div class="account">
                    <a asp-controller="Account" asp-action="Exit" class="exit">Вихід</a>
                </div>
            }
            </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Guestbook
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
